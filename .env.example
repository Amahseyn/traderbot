# Copy to .env and fill from Nobitex API panel (profile + terminal run + live orders).
NOBITEX_API_PUBLIC_KEY=
NOBITEX_API_PRIVATE_KEY=
# NOBITEX_API_BASE=https://apiv2.nobitex.ir

# Lab API bearer token (./run-lab-api.sh and ./run-lab-ui.sh load this; UI mirror is auto-synced).
# LAB_API_TOKEN=
# Local dev only: LAB_API_DISABLE_AUTH=1

# CoinBeacon market discovery (Lab API only, server-side)
COINBEACON_API_KEY=
COINBEACON_API_KEY_ALT=
