# Browser calls this path; Next.js rewrites /lab-api/* to FastAPI (see next.config.ts).
NEXT_PUBLIC_API_BASE=/lab-api

# Optional: override where Next proxies /lab-api (default http://127.0.0.1:8765).
# LAB_API_PROXY_TARGET=http://127.0.0.1:8765

# Must match LAB_API_TOKEN on the Lab API (./run-lab-ui.sh syncs from traderbot/.env when set).
# NEXT_PUBLIC_LAB_API_TOKEN=
